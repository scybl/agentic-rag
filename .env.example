# 仅首次复制为 .env；不要覆盖已有配置。完整默认表达式由 docs/reference.md 自动生成。
# 这是示例配置：EVAL_MODEL 在未设置时跟随 LLM_MODEL，此处显式填写会覆盖该回退。

# Ollama 提供的对话模型（必须先执行 `ollama pull qwen2.5:3b` 拉取模型）
LLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_WARMUP_ENABLED=true
OLLAMA_WARMUP_ATTEMPTS=10
OLLAMA_WARMUP_RETRY_SECONDS=3
OLLAMA_KEEP_ALIVE=30m
LLM_TEMPERATURE=0
LLM_MAX_ATTEMPTS=6
# 示例 qwen2.5 不支持思考；支持思考的模型可设 true，并按实测提高输出/上下文额度与超时，参见运行指南。
LLM_REASONING=false
LLM_CONTEXT_WINDOW=8192
LLM_MAX_OUTPUT_TOKENS=2048
# 每个输入单元最多 3 次模型尝试（包含首轮）；动态调整受以下配置约束。
LLM_ADAPTIVE_MAX_ATTEMPTS=3
LLM_ADAPTIVE_MAX_OUTPUT_TOKENS=3072
LLM_ADAPTIVE_MAX_CONTEXT_WINDOW=8192
LLM_ADAPTIVE_MAX_REQUEST_TIMEOUT=240

# RAGAS 评估使用的裁判模型。在 CPU 上默认复用小型对话模型；如果条件允许，
# 可在此使用更大的模型，以获得更可靠的分数。
EVAL_MODEL=qwen2.5:3b

# 轻量中文嵌入模型，适合中文知识检索和本地运行
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 检索
CHROMA_DIR=.chroma
CHROMA_COLLECTION=knowledge_base
KNOWLEDGE_DIR=knowledge
RETRIEVAL_K=4
GENERATION_MAX_DOCUMENTS=9
GENERATION_CONTEXT_CHARS=6000
NEWS_RETRIEVAL_K=5
# 正文预算与候选收集分离；候选按实际查询条件取完所有页。
# 旧 NEWS_CANDIDATE_K 不再生效。
NEWS_VECTOR_CACHE_ENABLED=true
# 针对缺失事实补搜的轮次；不会改写用户原始问题。
MAX_RETRIES=2
# 有证据但没有完成任务、或存在可纠正错误时，最多重写几次答案。
MAX_ANSWER_REVISIONS=2

# 开发阶段默认关闭；设为 true 后，问答程序会后台增量监听 knowledge/。
KNOWLEDGE_WATCH_ENABLED=false
KNOWLEDGE_WATCH_INTERVAL=2

# 只有问题、证据、模型、提示词版本、日期及实际证据片段一致时才复用分析。
ANALYSIS_CACHE_ENABLED=true
ANALYSIS_CACHE_PATH=.chroma/analysis_cache.sqlite3
ANALYSIS_CACHE_TTL_SECONDS=3600

# 持久化多 Agent 研究模式：默认开启，不需要覆盖你现有的 .env。
RESEARCH_ENABLED=true
RESEARCH_DB=.chroma/research.sqlite3
CHECKPOINT_DB=.chroma/checkpoints.sqlite3
MEMORY_VECTOR_DIR=.chroma/memory
# 三种上限分开：工作线程、进程内模型请求、进程内网络请求。
AGENT_WORKERS=4
LLM_CONCURRENCY=2
IO_CONCURRENCY=4
# 每个研究最多20个不同子任务，最多3轮补搜。关闭研究模式时使用上面的 MAX_RETRIES。
RESEARCH_MAX_TASKS=20
RESEARCH_MAX_ROUNDS=3
SPECIALIST_COUNT=3
TASK_MAX_ATTEMPTS=2
TASK_LEASE_SECONDS=180
TASK_WAIT_SECONDS=240
# 单次模型 HTTP 请求超时；单批任务调度超时（秒），不是整次研究的总耗时。
LLM_REQUEST_TIMEOUT=120
RESEARCH_TIMEOUT=900
# 逐段阅读的字符预算；完整阅读成果跨问题复用，部分阅读不冒充完整。
READING_CHUNK_CHARS=2200
MEMORY_RECALL_K=3

# 三个描述只用于告诉路由器各数据源的能力边界，不作为回答问题的事实依据。
# knowledge/ 当前提供的是稳定的财经分析方法，不负责回答实时新闻事实。
KNOWLEDGE_DESCRIPTION=本地财经新闻分析方法知识库，包含新闻来源核验与可信度分级、企业财务影响与重要性分析、事件研究法与市场反应评估；用于解释分析框架和方法，不包含实时新闻事实或个股投资建议。

# 路由器用于识别私有新闻服务器覆盖范围的描述。
NEWS_DESCRIPTION=只读同花顺新闻库，持续更新，覆盖产经新闻、区域经济、公司新闻、国际财经、财经评论、财经要闻、宏观经济、金融市场和财经人物；支持按关键词、日期和栏目查询，适合回答近期或历史财经新闻问题，不包含通用知识教程和非新闻类公司内部资料。

# 公开网络搜索的能力边界；当前实现使用 DuckDuckGo，并只把搜索摘要交给模型。
WEB_DESCRIPTION=DuckDuckGo 公开网络搜索，返回相关网页的标题、链接和摘要；适合查询本地文档与私有新闻库未覆盖的公开信息和非财经时效信息；结果来自公开互联网，不代表用户的私有资料，也不保证来源权威性。

# 只读同花顺新闻 API；路由器按问题选择，可与其他来源同时使用。
NEWS_API_BASE_URL=https://106.54.27.114:3001
# 在本机环境变量或被 Git 忽略的 .env 中设置 NEWS_API_KEY；不要提交真实 Key。
# NEWS_API_KEY=news_bizare_...

# 本机新闻候选向量缓存与知识索引、研究记忆分别保存；相对路径以项目根目录为基准。
NEWS_CHROMA_DIR=.chroma/news
NEWS_CHROMA_COLLECTION=tonghuashun_news
